<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pulse.Base</RootNamespace>
    <AssemblyName>Pulse.Base</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single image library for all platforms: ImageSharp instead of System.Drawing.Common -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Disable default globbing to avoid duplicate Compile -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProviderManager.Modern.cs" />
    <Compile Include="PictureManager.ImageSharp.cs" />
    <Compile Include="Picture.cs" />
    <Compile Include="..\..\..\Pulse\Pulse.Base\**\*.cs" Link="Legacy\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\..\..\Pulse\Pulse.Base\Properties\*.cs;..\..\..\Pulse\Pulse.Base\Pictures\PictureManager.cs;..\..\..\Pulse\Pulse.Base\Pictures\Picture.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\Pulse\Pulse.Base\Properties\Resources.resx" Link="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework> <!-- Must match Base TFM (net8.0-windows10.0.22621.0) for compat, even though API pure -->
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>wallhaven</AssemblyName>
    <RootNamespace>wallhaven</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Pulse.Base.Abstractions\Pulse.Base.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>

  <!-- Modern cross-platform: use modern Provider.cs from legacy rewrite (already net8 compatible) but as pure provider -->
  <ItemGroup>
    <Compile Include="..\..\..\..\Pulse\Providers\wallbase\Provider.cs" Link="Provider.cs" />
    <Compile Include="..\..\..\..\Pulse\Providers\wallbase\WallbaseImageSearchSettings.cs" Link="WallbaseImageSearchSettings.cs" />
    <Compile Include="..\..\..\..\Pulse\Providers\wallbase\WallbaseAccessDeniedException.cs" Link="WallbaseAccessDeniedException.cs" />
  </ItemGroup>

</Project>

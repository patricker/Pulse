<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework> <!-- Pure cross-platform, no OS specific -->
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BingWallpaper</AssemblyName>
    <RootNamespace>BingWallpaper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Pulse.Base.Abstractions\Pulse.Base.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>

  <!-- 
  This is an example modern provider for .NET 8 migration:
  - No WebClient, uses HttpClient + System.Text.Json
  - No API key needed (Bing HPImageArchive is free)
  - Demonstrates async pattern (GetPicturesAsync wrapper)
  - Can be built for any OS, but wallpaper setting still Windows-only via output provider
  -->
</Project>

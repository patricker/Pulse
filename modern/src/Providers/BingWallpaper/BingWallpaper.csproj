<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework> <!-- Must match Base TFM for NU1201 compat -->
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BingWallpaper</AssemblyName>
    <RootNamespace>BingWallpaper</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Pulse.Base\Pulse.Base.csproj" />
  </ItemGroup>

  <!-- 
  This is an example modern provider for .NET 8 migration:
  - No WebClient, uses HttpClient + System.Text.Json
  - No API key needed (Bing HPImageArchive is free)
  - Demonstrates async pattern (GetPicturesAsync wrapper)
  - Can be built for any OS, but wallpaper setting still Windows-only via output provider
  -->
</Project>

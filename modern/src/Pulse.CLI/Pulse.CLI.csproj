  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pulse.CLI</AssemblyName>
    <RootNamespace>Pulse.CLI</RootNamespace>
    <!-- Cross-platform console, no Windows targeting needed -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulse.Base\Pulse.Base.csproj" />
    <ProjectReference Include="..\Providers\wallbase\wallhaven.csproj" />
    <ProjectReference Include="..\Providers\BingWallpaper\BingWallpaper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>
</Project>

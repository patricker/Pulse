<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <AssemblyName>Pulse</AssemblyName>
    <RootNamespace>Pulse</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained> <!-- Set true for single-file with runtime -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- For trimming (optional, may break COM) -->
    <!-- <PublishTrimmed>false</PublishTrimmed> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulse.Base\Pulse.Base.csproj" />
    <ProjectReference Include="..\Providers\WinAPI\WinAPI.csproj" />
  </ItemGroup>

  <!-- Link legacy WPF source files -->
  <ItemGroup>
    <Compile Include="..\..\..\..\Pulse\Pulse\Pulse\**\*.cs" Link="Legacy\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\..\..\..\Pulse\Pulse\Pulse\Properties\*.cs" />
    <!-- XAML -->
    <Page Include="..\..\..\..\Pulse\Pulse\Pulse\**\*.xaml" Link="Legacy\%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="..\..\..\..\Pulse\Pulse\Pulse\Resources\**\*" Link="Legacy\Resources\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\Pulse\Pulse\Pulse\Properties\app.manifest" Link="Properties\app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Legacy\App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

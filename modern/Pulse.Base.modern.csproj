<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Enable Win10+ APIs (17763 = 1809, minimum for UserProfilePersonalizationSettings) -->
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pulse.Base</AssemblyName>
    <RootNamespace>Pulse.Base</RootNamespace>
    <!-- System.Drawing.Common needs Windows support in net8 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Replace System.Drawing with ImageSharp for cross-platform if needed, but keep Drawing for Windows -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- HttpClient is built-in, no need for WebClient -->
  </ItemGroup>

  <!-- 
  Migration notes from net4.8:
  - WebClient -> HttpClient (async)
  - PictureManager.ShrinkImage using System.Drawing still works on Windows, but for cross-platform consider ImageSharp
  - ProviderManager: Assembly.LoadFrom still works, but consider using AssemblyLoadContext
  - Log: keep
  -->
</Project>
